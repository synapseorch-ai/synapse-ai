FROM python:3.11-slim

# Node 20 + npm for the MCP servers, from Debian. Mirrors the combined root
# Dockerfile. The base is now Debian 13 trixie, whose nodejs is already v20, so the
# old "distro nodejs is v18, too old" reason for NodeSource no longer holds. Do NOT
# go back to `curl -fsSL …nodesource… | bash -`: the pipe discards curl's exit code,
# so an intermittent 403 fell through to Debian's `nodejs` — which ships only
# /usr/bin/node, no npm/npx — and that is how v1.8.4 shipped with npx missing.
# npm is a separate package here; the assertion below keeps it from vanishing again.
RUN apt-get update && apt-get install -y \
    build-essential curl libpq-dev nodejs npm \
    && node --version && npx --version \
    && rm -rf /var/lib/apt/lists/*

# Pre-install the native MCP servers so the backend's `npx -y …` startup calls
# resolve them from disk instead of downloading from npm on a cold container —
# those cold downloads pushed boot past the compose healthcheck window and made
# synapse-backend report unhealthy. Browser binaries come from the pip
# `playwright install` step below, so skip npm's browser download here.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm install -g \
    @modelcontextprotocol/server-filesystem \
    @modelcontextprotocol/server-memory \
    @modelcontextprotocol/server-sequential-thinking \
    @playwright/mcp

RUN pip install playwright && playwright install chromium --with-deps

WORKDIR /app

# Install from the lockfile so images resolve the exact tree CI tested.
# requirements.txt is copied too, as the fallback and for provenance.
COPY backend/requirements.txt backend/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock

COPY backend/core ./core
COPY backend/services ./services
COPY backend/tools ./tools
COPY backend/main.py .
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONPATH=/app

# See the note in ./Dockerfile. Documents go to a database given as deployment
# configuration; tenant content goes to /data/blobs (or to S3, via the S3_*
# vars); rebuildable state stays off the volume because each replica owns its
# own. /data is the path 1.x mounted, and its JSON is imported from there once.
ENV SYNAPSE_BLOB_DIR=/data/blobs
ENV SYNAPSE_DB_URL=sqlite+aiosqlite:////data/synapse.db
ENV SYNAPSE_STATE_DIR=/var/lib/synapse/state
ENV SYNAPSE_SECRETS_DIR=/data
ENV SYNAPSE_DATA_DIR=/data
VOLUME /data

# Auto-generate + persist the internal token so InternalTokenMiddleware enforces
# by default. In compose, SYNAPSE_SECRETS_DIR is pointed at the shared volume so
# the frontend can read the same value; standalone `docker run` persists to /data.
ENV SYNAPSE_AUTOGEN_TOKEN=1
ENV SYNAPSE_TOKEN_MODE=generate

EXPOSE 8765
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "main.py"]
