# Synapse Worker Image
# Runs ARQ jobs that execute OrchestrationEngine and agent chat turns.
# Does NOT include the frontend or playwright browser automation.
FROM python:3.13-slim

# Node 20 + npm for the npx-based MCP servers, from Debian (base is Debian 13
# trixie, whose nodejs is already v20). Do NOT go back to
# `curl -fsSL …nodesource… | bash -`: the pipe discards curl's exit code, so an
# intermittent 403 fell through to Debian's `nodejs` — which ships only
# /usr/bin/node, no npm/npx — and that is how v1.8.4 shipped with npx missing.
# npm is a separate package here; the assertion below keeps it from vanishing again.
RUN apt-get update && apt-get install -y \
    build-essential curl libpq-dev nodejs npm \
    && node --version && npx --version \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

# requirements-worker.lock is compiled from requirements.txt + requirements-worker.txt
# together, so it covers both. The .txt specs come along as fallback/provenance.
COPY backend/requirements.txt backend/requirements-worker.txt backend/requirements-worker.lock ./
RUN pip install --no-cache-dir -r requirements-worker.lock

COPY backend/core ./core
COPY backend/services ./services
COPY backend/tools ./tools
COPY backend/worker_main.py .

ENV PYTHONPATH=/app/backend

# A worker holds no install of its own: the database it reads is deployment
# configuration, and tenant content is shared with the API — through S3 in a
# real deployment, or a shared /blobs volume in compose. No default DB URL
# here, deliberately; a worker with a private SQLite file would run every job
# against an empty install and never say so.
ENV SYNAPSE_BLOB_DIR=/blobs
ENV SYNAPSE_STATE_DIR=/var/lib/synapse/state

# Core connection URLs (required for scale mode)
ENV REDIS_URL=""
ENV SCALE_POSTGRES_URL=""
ENV SYNAPSE_DB_URL=""

# Worker tuning
ENV WORKER_HEALTH_PORT=9000
ENV WORKER_CONCURRENCY=10
ENV WORKER_JOB_TIMEOUT=3600
ENV WORKER_MAX_RETRIES=3

# WORKER_QUEUE_SHARD, DEFAULT_TENANT_ID and ENABLE_TENANT_ISOLATION are gone.
# The engine reads none of them: the queue name is a constant, because a queue
# bound to a tenant is one worker pool per tenant — which is the shape a shared
# fleet exists to remove.

# Database
ENV PGBOUNCER_MODE=0

# S3 storage (vault + execution logs)
ENV S3_BUCKET=""
ENV S3_REGION=us-east-1
ENV S3_PREFIX=synapse
ENV S3_ACCESS_KEY_ID=""
ENV S3_SECRET_ACCESS_KEY=""
ENV S3_ENDPOINT_URL=""

# Observability
ENV OTLP_ENDPOINT=""
ENV METRICS_TOKEN=""

# Kubernetes mode
ENV K8S_MODE=0

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

CMD ["python", "worker_main.py"]
