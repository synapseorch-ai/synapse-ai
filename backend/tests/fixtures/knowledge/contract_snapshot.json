{
 "agent": {
  "label_re": "\\[K(\\d{1,3})\\]",
  "read_schema": {
   "properties": {
    "label": {
     "description": "A result's label from search_knowledge, e.g. [K3].",
     "type": "string"
    },
    "window": {
     "description": "How many neighbouring passages to include on each side, 0 to 3.",
     "type": "integer"
    }
   },
   "required": [
    "label"
   ],
   "type": "object"
  },
  "search_schema": {
   "properties": {
    "filters": {
     "description": "Optional JSON metadata filter, e.g. {\"doc_type\": \"contract\", \"year\": {\"$gte\": 2024}}.",
     "type": "string"
    },
    "kb": {
     "description": "A knowledge base's id or name. Leave it out to search all of yours.",
     "type": "string"
    },
    "query": {
     "description": "What to look for, in plain words.",
     "type": "string"
    },
    "top_k": {
     "description": "How many results, 1 to 20.",
     "type": "integer"
    }
   },
   "required": [
    "query"
   ],
   "type": "object"
  },
  "tools": [
   "search_knowledge",
   "read_knowledge"
  ]
 },
 "cost": {
  "sources": [
   "platform",
   "byok",
   "local"
  ],
  "stages": [
   "parse",
   "ocr",
   "embed",
   "rerank",
   "enrich",
   "rewrite"
  ],
  "units": [
   "tokens",
   "pages",
   "search_units",
   "requests"
  ]
 },
 "events": {
  "lifecycle": [
   "knowledge.document.queued",
   "knowledge.document.indexed",
   "knowledge.document.partial",
   "knowledge.document.failed",
   "knowledge.document.skipped",
   "knowledge.document.paused",
   "knowledge.document.blocked",
   "knowledge.document.deleted",
   "knowledge.base.reindexed",
   "knowledge.base.paused",
   "knowledge.base.resumed",
   "knowledge.snapshot.failed"
  ],
  "owners": {
   "knowledge_citations": "B1",
   "knowledge_ingest": "R1",
   "knowledge_read": "B1",
   "knowledge_retrieve": "R1",
   "knowledge_search": "B1"
  },
  "run": [
   "knowledge_search",
   "knowledge_read",
   "knowledge_citations",
   "knowledge_retrieve",
   "knowledge_ingest"
  ],
  "webhooks": {
   "base.reindexed": "knowledge.base.reindexed",
   "document.failed": "knowledge.document.failed",
   "document.indexed": "knowledge.document.indexed",
   "document.partial": "knowledge.document.partial"
  }
 },
 "filters": {
  "builtins": {
   "doc_date": "date",
   "indexed_at": "datetime",
   "mime": "string",
   "path": "string",
   "source": "enum",
   "title": "string"
  },
  "error_codes": [
   "bad_json",
   "not_an_object",
   "too_deep",
   "too_many_conditions",
   "too_many_values",
   "empty_list",
   "unknown_operator",
   "bad_field",
   "bad_value",
   "type_mismatch"
  ],
  "field_re": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
  "limits": {
   "max_conditions": 50,
   "max_depth": 4,
   "max_in_values": 100,
   "max_string": 1000
  },
  "ops": [
   "$eq",
   "$ne",
   "$gt",
   "$gte",
   "$lt",
   "$lte",
   "$in",
   "$nin",
   "$exists",
   "$and",
   "$or",
   "$not"
  ],
  "reserved": [
   "indexed_at",
   "mime",
   "path",
   "source"
  ],
  "sources": [
   "upload",
   "web",
   "record",
   "vault"
  ]
 },
 "ids": {
  "dirs": [
   "_web",
   "_records"
  ],
  "prefixes": [
   "kb_",
   "kdoc_",
   "ksnap_",
   "kq_",
   "kch_",
   "kup_",
   "kcr_",
   "kev_",
   "kws_"
  ],
  "record_id": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
 },
 "kb": {
  "collection": "knowledge_bases",
  "index_affecting": [
   "chunking",
   "embedding",
   "enrichment",
   "language"
  ],
  "refused_roots": [
   "compaction_archives",
   "playwright",
   "tool_outputs"
  ],
  "schema": {
   "$defs": {
    "Chunking": {
     "additionalProperties": false,
     "properties": {
      "max_tokens": {
       "default": 800,
       "maximum": 4000,
       "minimum": 64,
       "title": "Max Tokens",
       "type": "integer"
      },
      "mode": {
       "default": "structure",
       "enum": [
        "structure",
        "fixed",
        "page",
        "none"
       ],
       "title": "Mode",
       "type": "string"
      },
      "overlap_pct": {
       "default": 0.0,
       "maximum": 0.25,
       "minimum": 0.0,
       "title": "Overlap Pct",
       "type": "number"
      },
      "target_tokens": {
       "default": 450,
       "maximum": 2000,
       "minimum": 64,
       "title": "Target Tokens",
       "type": "integer"
      }
     },
     "title": "Chunking",
     "type": "object"
    },
    "Embedding": {
     "additionalProperties": false,
     "description": "The embedding model. \"\" means the deployment's default (cloud: Titan v2 1024-d).",
     "properties": {
      "dims": {
       "anyOf": [
        {
         "maximum": 8192,
         "minimum": 1,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Dims"
      },
      "model": {
       "default": "",
       "title": "Model",
       "type": "string"
      },
      "profile": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Profile"
      }
     },
     "title": "Embedding",
     "type": "object"
    },
    "Enrichment": {
     "additionalProperties": false,
     "description": "\"prefix\" is deterministic and free; \"contextual\" is Contextual Retrieval, an opt-in\nbehind a cost preview (D153 #3), on any chat model including the org's own.",
     "properties": {
      "contextual_model": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Contextual Model"
      },
      "extract_metadata": {
       "default": false,
       "title": "Extract Metadata",
       "type": "boolean"
      },
      "mode": {
       "default": "prefix",
       "enum": [
        "prefix",
        "contextual"
       ],
       "title": "Mode",
       "type": "string"
      }
     },
     "title": "Enrichment",
     "type": "object"
    },
    "Fusion": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "const": "rrf",
       "default": "rrf",
       "title": "Method",
       "type": "string"
      },
      "overfetch": {
       "default": 50,
       "maximum": 200,
       "minimum": 10,
       "title": "Overfetch",
       "type": "integer"
      },
      "rrf_k": {
       "default": 60,
       "maximum": 1000,
       "minimum": 1,
       "title": "Rrf K",
       "type": "integer"
      },
      "weights": {
       "additionalProperties": {
        "type": "number"
       },
       "title": "Weights",
       "type": "object"
      }
     },
     "title": "Fusion",
     "type": "object"
    },
    "Rerank": {
     "additionalProperties": false,
     "description": "None means the deployment's default: on in cloud, off in OSS unless configured.",
     "properties": {
      "candidates": {
       "default": 50,
       "maximum": 100,
       "minimum": 1,
       "title": "Candidates",
       "type": "integer"
      },
      "enabled": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Enabled"
      },
      "model": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Model"
      },
      "top_n": {
       "default": 8,
       "maximum": 50,
       "minimum": 1,
       "title": "Top N",
       "type": "integer"
      }
     },
     "title": "Rerank",
     "type": "object"
    },
    "Retrieval": {
     "additionalProperties": false,
     "properties": {
      "max_context_tokens": {
       "default": 6000,
       "maximum": 100000,
       "minimum": 500,
       "title": "Max Context Tokens",
       "type": "integer"
      },
      "neighbor_window": {
       "default": 1,
       "maximum": 3,
       "minimum": 0,
       "title": "Neighbor Window",
       "type": "integer"
      },
      "parent_expansion": {
       "default": "off",
       "enum": [
        "off",
        "section",
        "neighbors"
       ],
       "title": "Parent Expansion",
       "type": "string"
      },
      "score_threshold": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Score Threshold"
      },
      "top_k": {
       "default": 8,
       "maximum": 50,
       "minimum": 1,
       "title": "Top K",
       "type": "integer"
      }
     },
     "title": "Retrieval",
     "type": "object"
    },
    "Web": {
     "additionalProperties": false,
     "description": "Per-KB crawl settings, each bounded by the deployment's caps (`config.py`).",
     "properties": {
      "max_depth": {
       "default": 3,
       "maximum": 5,
       "minimum": 0,
       "title": "Max Depth",
       "type": "integer"
      },
      "max_pages": {
       "default": 500,
       "maximum": 100000,
       "minimum": 1,
       "title": "Max Pages",
       "type": "integer"
      },
      "recrawl_days": {
       "default": 7,
       "maximum": 365,
       "minimum": 0,
       "title": "Recrawl Days",
       "type": "integer"
      },
      "rps_per_host": {
       "default": 1.0,
       "exclusiveMinimum": 0,
       "maximum": 10,
       "title": "Rps Per Host",
       "type": "number"
      },
      "sources": {
       "items": {
        "$ref": "#/$defs/WebSource"
       },
       "maxItems": 50,
       "title": "Sources",
       "type": "array"
      }
     },
     "title": "Web",
     "type": "object"
    },
    "WebSource": {
     "additionalProperties": false,
     "properties": {
      "exclude": {
       "items": {
        "type": "string"
       },
       "maxItems": 50,
       "title": "Exclude",
       "type": "array"
      },
      "id": {
       "title": "Id",
       "type": "string"
      },
      "include": {
       "items": {
        "type": "string"
       },
       "maxItems": 50,
       "title": "Include",
       "type": "array"
      },
      "kind": {
       "default": "page",
       "enum": [
        "page",
        "sitemap",
        "site"
       ],
       "title": "Kind",
       "type": "string"
      },
      "url": {
       "maxLength": 2048,
       "title": "Url",
       "type": "string"
      }
     },
     "required": [
      "id",
      "url"
     ],
     "title": "WebSource",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "budget_monthly_usd": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Budget Monthly Usd"
    },
    "chunking": {
     "$ref": "#/$defs/Chunking"
    },
    "created_at": {
     "default": "",
     "title": "Created At",
     "type": "string"
    },
    "description": {
     "default": "",
     "maxLength": 2000,
     "title": "Description",
     "type": "string"
    },
    "embedding": {
     "$ref": "#/$defs/Embedding"
    },
    "enrichment": {
     "$ref": "#/$defs/Enrichment"
    },
    "folder": {
     "title": "Folder",
     "type": "string"
    },
    "fusion": {
     "$ref": "#/$defs/Fusion"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "language": {
     "default": "simple",
     "title": "Language",
     "type": "string"
    },
    "name": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Name",
     "type": "string"
    },
    "rerank": {
     "$ref": "#/$defs/Rerank"
    },
    "retrieval": {
     "$ref": "#/$defs/Retrieval"
    },
    "revision": {
     "default": 1,
     "minimum": 1,
     "title": "Revision",
     "type": "integer"
    },
    "status": {
     "default": "active",
     "enum": [
      "active",
      "disabled"
     ],
     "title": "Status",
     "type": "string"
    },
    "updated_at": {
     "default": "",
     "title": "Updated At",
     "type": "string"
    },
    "visitor_access": {
     "default": false,
     "title": "Visitor Access",
     "type": "boolean"
    },
    "web": {
     "$ref": "#/$defs/Web"
    }
   },
   "required": [
    "id",
    "name",
    "folder"
   ],
   "title": "KnowledgeBase",
   "type": "object"
  }
 },
